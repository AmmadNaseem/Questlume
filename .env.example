# Application name
APP_NAME=Questlume

# Choose: groq, gemini or openrouter. Configure every selected fallback too.

# Gemini configuration
GEMINI_MODEL=
GOOGLE_API_KEY=

# OpenRouter configuration
OPENROUTER_MODEL=
OPENROUTER_API_KEY=

# Shared generation settings
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=["openrouter","gemini"]
GROQ_MODEL=
GROQ_API_KEY=
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
WEB_QUERY_COUNT=3
WEB_RESULTS_PER_QUERY=5
WEB_MAX_PAGES=8
WEB_MIN_PAGES=2
WEB_ALLOWED_DOMAINS=["docs.python.org","angular.dev","learn.microsoft.com","docs.langchain.com","developer.mozilla.org"]
PRESENTATION_REVISION_LIMIT=2
PRESENTATION_CONTEXT_MAX_CHARS=24000
PRESENTATION_RETRIEVAL_K=12
PRESENTATION_MAX_TITLE_CHARS=100
PRESENTATION_MAX_BULLETS=5
PRESENTATION_MAX_BULLET_CHARS=220
PRESENTATION_MAX_CODE_CHARS=1500
PRESENTATION_MAX_NOTES_CHARS=2000
# PowerPoint renderer: absolute paths to an installed Codex Artifact Tool runtime.
RENDER_NODE_EXECUTABLE=node
RENDER_ARTIFACT_MODULE=
RENDER_SKILL_DIR=
RENDER_VALIDATION_PYTHON=python
RENDER_TIMEOUT_SECONDS=300
RENDER_MAX_PLAN_BYTES=2000000
